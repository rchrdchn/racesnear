---
layout: base.njk
pagination: { data: cal.list, size: 1, alias: m, addAllPagesToCollections: true }
permalink: "/{{ m.slug }}/this-weekend/"
eleventyComputed:
  title: "Races near {{ m.near }} This Weekend ({{ cal.wkS | mds }}) | {{ site.name }}"
  description: "Every running race in {{ m.name }} this weekend: {{ m.weekend.length }} races with start times, distances, prices and how to register."
  nlMetro: "{{ m.slug }}"
---
{% import "macros.njk" as k %}
<div class="wrap">
<p class="crumbs"><a href="/">Home</a> / <a href="/{{ m.slug }}/">{{ m.name }}</a> / This weekend</p>
<h1>Races near {{ m.near }} this weekend</h1>
{% updated %}
<p class="lead"><strong>{{ hub.intro }}</strong>{% if m.weekend.length %} Many take race-day signups, but some close online registration the day before.{% endif %}</p>
<div class="sec"><h2>By date</h2></div>{{ k.list(m.weekend, cal.today, false, 'See what is coming up in the next 90 days on the ' + m.name + ' page.') }}
<p class="back"><a href="/{{ m.slug }}/#next90">See the next 90 days near {{ m.near }} →</a></p>
{% include "faq.njk" %}
</div>
