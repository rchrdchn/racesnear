---
layout: base.njk
permalink: /this-weekend/
eleventyComputed:
  title: "Races This Weekend in 10 US Cities ({{ cal.wkS | mds }}) | {{ site.name }}"
  description: "{{ cal.allWeekend.length }} running races this weekend across the Bay Area, NYC, LA, Chicago, Boston, DC, Seattle, Denver, Austin and San Diego."
---
{% import "macros.njk" as k %}
<div class="wrap">
<p class="crumbs"><a href="/">Home</a> / This weekend</p>
<h1>Races this weekend</h1>
{% updated %}
<p class="lead"><strong>{{ hub.intro }}</strong> Jump to your city:</p>
<p class="jump">{% for m in cal.list %}<a href="#{{ m.slug }}">{{ m.short }} ({{ m.weekend.length }})</a>{% endfor %}</p>
{% for m in cal.list %}<section id="{{ m.slug }}" aria-labelledby="h-{{ m.slug }}"><div class="sec"><h2 id="h-{{ m.slug }}">{{ m.name }}</h2><p class="sub">{{ m.weekend.length }} races</p><a class="more" href="/{{ m.slug }}/">Upcoming near {{ m.near }} →</a></div>{{ k.list(m.weekend, cal.today, false, 'Nothing listed in ' + m.name + ' this weekend.') }}</section>{% endfor %}
{% include "faq.njk" %}
</div>
