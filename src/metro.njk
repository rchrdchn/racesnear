---
layout: base.njk
pagination: { data: cal.list, size: 1, alias: m }
permalink: "/{{ m.slug }}/"
eleventyComputed:
  title: "Upcoming Races near {{ m.near }} ({{ cal.seasonYears }}): 5Ks to Marathons | {{ site.name }}"
  description: "{{ m.next90.length }} running races near {{ m.near }} in the next 90 days: 5Ks, 10Ks, half marathons, marathons and trail races, with prices, early-bird deadlines and registration links."
  nlMetro: "{{ m.slug }}"
---
{% import "macros.njk" as k %}
<div class="wrap">
<p class="crumbs"><a href="/">Home</a> / {{ m.name }}</p>
<section class="mhero"><h1>Upcoming races near {{ m.near }}</h1>
<p class="lead"><strong>{{ m.next90.length }} race{% if m.next90.length != 1 %}s{% endif %} in the next 90 days</strong> (through {{ cal.in90 | md }}) and {{ m.count }} on the calendar for the next 12 months, across {{ m.blurb | replace(".", "") }}.{% if m.early.length %} {{ m.early.length }} race{% if m.early.length != 1 %}s{% endif %} raise their price in the next three weeks.{% endif %}</p>
<p class="jump"><a href="#next90">Next 90 days</a><a href="#early">Early-bird deadlines</a><a href="#weekend">This weekend ({{ m.weekend.length }})</a><a href="#browse">By distance, season, month or area</a></p></section>
<section id="next90" aria-labelledby="h90"><div class="sec"><h2 id="h90">Next 90 days</h2><p class="sub">{{ m.next90.length }} races through {{ cal.in90 | md }}</p></div>
{{ k.filters(m, m.dists) }}<div class="fwrap">{{ k.list(m.next90, cal.today) }}<p class="empty fnone" hidden>No races match those filters in the next 90 days. Try another distance or area.</p></div></section>
<section id="early" aria-labelledby="heb"><div class="sec"><h2 id="heb">Early-bird prices ending soon</h2><p class="sub">Register before these dates to pay less.</p></div>{{ k.early(m.early, cal.today) }}</section>
<section id="weekend" aria-labelledby="h1w"><div class="sec"><h2 id="h1w">This weekend</h2><a class="more" href="/{{ m.slug }}/this-weekend/">Weekend page →</a></div>{{ k.list(m.weekend, cal.today, false, 'Nothing on the calendar this weekend yet. See the next 90 days above.') }}</section>
<section id="browse" aria-labelledby="hbr"><div class="sec"><h2 id="hbr">Plan ahead near {{ m.near }}</h2></div>
<h3 class="minor">By distance</h3>{% set items = [] %}{% for d in m.dists %}{% set items = (items.push(["/" + m.slug + "/" + d.slug + "/", d.name + " near " + m.short, d.count + " upcoming"]), items) %}{% endfor %}{{ k.links(items) }}
<h3 class="minor">By season</h3>{% set items = [] %}{% for se in m.seasons %}{% set items = (items.push(["/" + m.slug + "/" + se.slug + "-races/", se.name + " " + se.label + " races", se.count + " races, " + se.months]), items) %}{% for d in se.dists %}{% if d.cat == 'half' or d.cat == 'marathon' %}{% set items = (items.push(["/" + m.slug + "/" + se.slug + "-" + d.slug + "/", se.name + " " + (d.name | lower), d.count + " in " + se.name + " " + se.label]), items) %}{% endif %}{% endfor %}{% endfor %}{{ k.links(items) }}
<h3 class="minor">By month</h3>{% set items = [] %}{% for mo in m.months %}{% set items = (items.push(["/" + m.slug + "/" + mo.y + "/" + mo.slug + "/", mo.name + " " + mo.y, mo.count + " races"]), items) %}{% endfor %}{{ k.links(items) }}
<h3 class="minor">By area</h3>{% set items = [] %}{% for g in m.regions %}{% set items = (items.push(["/" + m.slug + "/" + g.slug + "/", g.name, g.count + " upcoming"]), items) %}{% endfor %}{{ k.links(items) }}
</section>
</div>
