<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><script>document.documentElement.classList.add("js")</script>
{% set t = title | seoTitle %}{% set d = description | seoDesc %}{% set ogimg = page.url | ogImage %}<title>{{ t }}</title><meta name="description" content="{{ d }}"><link rel="canonical" href="{{ site.url }}{{ page.url }}"><meta name="theme-color" content="#0b4a6f">
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="manifest" href="/site.webmanifest"><link rel="alternate" type="application/rss+xml" title="{{ site.name }} guides" href="/feed.xml"><link rel="help" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="preload" href="/assets/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
<meta property="og:site_name" content="{{ site.name }}"><meta property="og:title" content="{{ t }}"><meta property="og:description" content="{{ d }}"><meta property="og:type" content="{{ 'article' if article else 'website' }}"><meta property="og:url" content="{{ site.url }}{{ page.url }}"><meta property="og:image" content="{{ ogimg }}"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="{{ t }}"><meta property="og:video" content="{{ site.url }}/assets/og-video.mp4"><meta property="og:video:secure_url" content="{{ site.url }}/assets/og-video.mp4"><meta property="og:video:type" content="video/mp4"><meta property="og:video:width" content="1280"><meta property="og:video:height" content="720"><meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ t }}"><meta name="twitter:description" content="{{ d }}"><meta name="twitter:image" content="{{ ogimg }}">
{% if noindex %}<meta name="robots" content="noindex">{% else %}<script type="application/ld+json">{{ { url: page.url, title: title, description: description, hub: hub, kind: kind, article: article, date: page.date } | pageGraph | safe }}</script>{% endif %}
{% if schema %}<script type="application/ld+json">{{ schema | json | safe }}</script>{% endif %}
<link rel="stylesheet" href="/assets/style.css?v={{ build.v }}">
</head><body><a class="skip" href="#main">Skip to content</a>
<div class="topbar" id="topbar"><div class="wrap"><header class="top"><a class="logo" href="/" aria-label="{{ site.name }} home"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path class="pin" d="M16 2.5c-6.1 0-11 4.8-11 10.8 0 7.9 9.4 15.4 10.1 15.9.5.4 1.3.4 1.8 0 .7-.5 10.1-8 10.1-15.9C27 7.3 22.1 2.5 16 2.5z"/><rect class="bib" x="9.5" y="8" width="13" height="10" rx="2"/><rect class="bibt" x="9.5" y="8" width="13" height="3.2" rx="1.5"/><circle class="bibh" cx="11.8" cy="9.6" r=".9"/><circle class="bibh" cx="20.2" cy="9.6" r=".9"/></svg><span>{{ site.logoA }} <em>{{ site.logoB }}</em></span></a>
<nav id="mainnav" aria-label="Main">{% set nav = [["/#cities","Cities"],["/upcoming/","Upcoming"],["/this-weekend/","This weekend"],["/price-increases/","Early-bird deadlines"],["/guides/","Guides"],["/about/","About"]] %}{% for n in nav %}<a href="{{ n[0] }}"{% if page.url == n[0] %} aria-current="page"{% endif %}>{{ n[1] }}</a>{% endfor %}<a class="nav-adv" href="/advertise/"{% if page.url == '/advertise/' %} aria-current="page"{% endif %}>Advertise</a></nav><div class="hcta"><a class="adv" href="/advertise/"{% if page.url == '/advertise/' %} aria-current="page"{% endif %}>Advertise</a><a class="nlb" href="{{ (nlMetro or '') | nlUrl }}"{% if site.newsletterUrl %} target="_blank" rel="noopener"{% endif %}>Free email</a></div><button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="mainnav"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span></button></header></div></div>
<main id="main">{{ content | safe }}</main>
<div class="wrap fband">{% include "newsletter.njk" %}</div>
<footer class="foot"><div class="wrap">
<div class="ftop">
<div class="fbrand"><a class="logo" href="/" aria-label="{{ site.name }} home"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path class="pin" d="M16 2.5c-6.1 0-11 4.8-11 10.8 0 7.9 9.4 15.4 10.1 15.9.5.4 1.3.4 1.8 0 .7-.5 10.1-8 10.1-15.9C27 7.3 22.1 2.5 16 2.5z"/><rect class="bib" x="9.5" y="8" width="13" height="10" rx="2"/><rect class="bibt" x="9.5" y="8" width="13" height="3.2" rx="1.5"/><circle class="bibh" cx="11.8" cy="9.6" r=".9"/><circle class="bibh" cx="20.2" cy="9.6" r=".9"/></svg><span>{{ site.logoA }} <em>{{ site.logoB }}</em></span></a>
<p class="ftag">{{ site.tagline }}</p>
<p class="fmail"><a href="mailto:{{ site.email }}">{{ site.email }}</a><button type="button" class="fcopy ecopy" data-email="{{ site.email }}" aria-label="Copy email address">Copy</button></p>
<a class="fadv" href="/advertise/">Advertise your race →</a></div>
<nav class="fl fcities" aria-label="Cities"><h3>Cities</h3>{% for m in cal.list %}<a href="/{{ m.slug }}/">{{ m.name }}</a>{% endfor %}</nav>
<nav class="fl" aria-label="Site"><h3>Site</h3><a href="/upcoming/">Upcoming races</a><a href="/this-weekend/">Races this weekend</a><a href="/price-increases/">Early-bird deadlines</a><a href="/guides/">Guides</a><a href="/tools/pace-calculator/">Pace calculator</a><a href="/newsletter/">Free weekly email</a><a href="/about/">About &amp; sources</a><a href="/advertise/">Advertise</a><a href="/privacy/">Privacy</a><a href="/sitemap.xml">Sitemap</a></nav>
</div>
<div class="fbar"><p class="legal">Race listings come from the RunSignup public race API, refreshed daily, plus a few major races checked by hand against their official sites. Dates, prices and start times can change, so confirm on the race's registration page before you go. Not affiliated with any race. RunSignup registration links are affiliate links (<a href="/about/#affiliate-links">details</a>).</p><p class="copy">© {{ build.year }} {{ site.name }}</p></div>
</div></footer>
{% if site.cfAnalyticsToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>{% endif %}
<script defer src="/assets/site.js?v={{ build.v }}"></script>
</body></html>
