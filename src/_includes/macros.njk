{% macro row(r, today, showMetro=false) %}<li class="race" data-c="{{ r.cats | join(' ') }}" data-r="{{ r.region }}">
<a class="cal" href="{{ r | raceUrl }}" aria-hidden="true" tabindex="-1"><span class="w">{{ r.date | wd }}</span><b>{{ r.date | day }}</b><span class="m">{{ r.date | mon }}</span></a>
<div class="rb"><h3><a href="{{ r | raceUrl }}">{{ r.name }}</a></h3>
<p class="where">{{ r.date | wd }} {{ r.date | mds }}{% if r.start %} · {{ r.start | t12 }}{% endif %} · {{ r.city }}{% if showMetro %}, {{ (r.metro | metro).short }}{% else %} · {{ r | regionName }}{% endif %}</p>
<p class="ds">{% for d in r.distances | limit(6) %}<span class="d{% if d.cat != 'other' %} {{ d.cat }}{% endif %}">{{ d.label }}</span>{% endfor %}{% if r.trail %}<span class="d trail">Trail</span>{% endif %}</p></div>
<div class="rp">{% if r.priceFrom %}<span class="pr">from <b>{{ r.priceFrom | money }}</b></span>{% elif r.source != 'RunSignup' %}<span class="pr">see site</span>{% endif %}{% if r.nextIncrease and r.nextIncrease.date >= today %}<span class="up">Goes up {{ r.nextIncrease.date | mds }}</span>{% elif r.badge and r.badge != 'Open' and r.badge != 'See site' %}<span class="cl">{{ r.badge.split(':')[0] | truncate(22, true, '') }}</span>{% elif not r.open %}<span class="cl">Reg. closed</span>{% endif %}</div>
</li>{% endmacro %}
{% macro list(races, today, showMetro=false, empty='No races listed yet.') %}{% if races.length %}<ul class="races">{% for r in races %}{{ row(r, today, showMetro) }}{% endfor %}</ul>{% else %}<p class="empty">{{ empty }}</p>{% endif %}{% endmacro %}
{% macro early(races, today, showMetro=false) %}{% if races.length %}<ul class="eb">{% for r in races %}<li><a href="{{ r | raceUrl }}"><span class="ebd"><b>{{ r.nextIncrease.date | mds }}</b><small>{% set n = r.nextIncrease.date | daysUntil(today) %}{% if n == 0 %}today{% elif n == 1 %}tomorrow{% else %}in {{ n }} days{% endif %}</small></span><span class="ebn"><strong>{{ r.name }}</strong><small>{{ r.nextIncrease.event }}: {{ r.nextIncrease.from | money }} → {{ r.nextIncrease.to | money }} · race {{ r.date | mds }} · {{ r.city }}{% if showMetro %}, {{ (r.metro | metro).short }}{% endif %}</small></span></a></li>{% endfor %}</ul>{% else %}<p class="empty">No price increases in the next three weeks.</p>{% endif %}{% endmacro %}
{% macro links(items) %}<ul class="lgrid">{% for i in items %}<li><a href="{{ i[0] }}"><span>{{ i[1] }}</span><small>{{ i[2] }}</small></a></li>{% endfor %}</ul>{% endmacro %}
{% macro filters(m, dists) %}<div class="filt" id="filt"><div class="fg" role="group" aria-label="Distance"><span class="fl1">Distance</span><button type="button" aria-pressed="true" data-f="c" data-v="">All</button>{% for d in dists %}<button type="button" aria-pressed="false" data-f="c" data-v="{{ d.cat }}">{{ d.short }}</button>{% endfor %}</div>
{% if m.regions.length > 1 %}<div class="fg" role="group" aria-label="Area"><span class="fl1">Area</span><button type="button" aria-pressed="true" data-f="r" data-v="">All</button>{% for g in m.regions %}<button type="button" aria-pressed="false" data-f="r" data-v="{{ g.slug }}">{{ g.name }}</button>{% endfor %}</div>{% endif %}
<p class="fcount" aria-live="polite">Showing {{ m.next90.length }} of {{ m.next90.length }} races</p></div>{% endmacro %}
