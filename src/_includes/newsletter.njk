{% set nm = nlMetro | metro if nlMetro else null %}
<section class="band" id="newsletter" aria-labelledby="nlh"><div class="bandt"><h2 id="nlh">{% if nm %}{{ nm.short }} races, every Thursday.{% else %}Your city's races, every Thursday.{% endif %}</h2><p>This weekend's races{% if nm %} in {{ nm.name }}{% endif %}, new events, and the early-bird prices about to go up. One short email, free.</p></div>
{% if site.newsletterUrl %}<a class="btn light" href="{{ (nlMetro or '') | nlUrl }}" target="_blank" rel="noopener">Get the free email →</a>{% else %}<p class="soon"><span class="tag">Coming soon</span> The weekly email launches shortly{% if nm %} with a {{ nm.short }} edition{% endif %}.</p>{% endif %}</section>
